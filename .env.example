# @BotFather dan olingan token
BOT_TOKEN=123456:ABC...

# Majburiy obuna kanali. Bot shu kanalda ADMIN bo'lishi shart!
CHANNEL_ID=@sefer_uz
CHANNEL_URL=https://t.me/sefer_uz
INSTAGRAM_URL=https://instagram.com/sefer.uz

# Anketalar yuboriladigan yopiq guruh (superguruh id, -100 bilan boshlanadi). Botni guruhga qo'shing.
ADMIN_CHAT_ID=-1001234567890
# /stats va /sync buyruqlaridan foydalana oladigan adminlar (vergul bilan)
ADMIN_IDS=111111111,222222222

REQUIRED_REFERRALS=3
ESSAY_MAX_WORDS=200

DB_PATH=data/bot.db
# Anketa holatlari bot qayta ishga tushganda yo'qolmasligi uchun (docker-compose'da avtomatik)
REDIS_URL=redis://localhost:6379/0

# Google Sheets (ixtiyoriy). Service account JSON fayli va jadval ID'si
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=Arizalar
